ENABLE_TESTS=true
ENABLE_CODE_COVERAGE=true
ENABLE_MUTATION_COVERAGE=false
## Style checks
ENABLE_CHECKSTYLE=true
## Formatting
ENABLE_FORMATTING=true
## Dependency checks
NVD_API_KEY=4fab110d-a850-4197-ad89-24bfa19dc14f
ENABLE_DEPENDENCY_CHECK=false
## Version Bump
ENABLE_VERSION_BUMP=true
## SpotBugs
ENABLE_SPOTBUGS=true
SPOTBUGS_FAIL_ON_ERROR=true
## PMD
ENABLE_PMD=true
PMD_FAIL_ON_VIOLATION=true
## Static Code Analysis
ENABLE_SONARQUBE=false
SONARQUBE_HOST_URL=https://sonarqube.cloudville.me
SONARQUBE_PROJECT_NAME={{ cookiecutter.project_slug }}
SONARQUBE_PROJECT_KEY={{ cookiecutter.project_slug }}
SONARQUBE_TOKEN=
## OpenAPI Spec Generation
ENABLE_OPENAPI_SPEC_GENERATION=true
APP_URL=http://localhost:8080

# Mock AWS / Localstack for build
AWS_REGION=ca-central-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_COGNITO_URL=http://localstack:4566
AWS_COGNITO_USER_POOL_URL=http://localstack:4566/ca-central-1_test
AWS_SECRETS_MANAGER_URL=http://localstack:4566
